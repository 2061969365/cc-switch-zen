FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY cc-switch-server-linux-amd64 /usr/local/bin/cc-switch-server
RUN chmod +x /usr/local/bin/cc-switch-server

ENV PORT=4096 \
    HOST=0.0.0.0 \
    RUST_LOG=info

EXPOSE 4096 15784

ENTRYPOINT ["/usr/local/bin/cc-switch-server"]
